<?xml version="1.0" encoding="UTF-8"?>
<!--
  CATATAN: proyek ini memakai runner sendiri (php tests/run.php), bukan PHPUnit.
  Berkas ini disediakan untuk dijalankan pemilik proyek bila PHPUnit dipasang, dan BELUM PERNAH dijalankan.
  Tes memperluas Tests\Support\TestCase (bukan PHPUnit\Framework\TestCase) dan memakai
  assertSame/assertTrue/assertContains buatan sendiri, jadi PHPUnit tidak dapat memakainya apa adanya;
  diperlukan adaptor atau migrasi kelas dasar lebih dulu.
-->
<phpunit bootstrap="bootstrap/autoload.php" colors="true" failOnWarning="true" failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
</phpunit>
