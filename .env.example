APP_ENV=production
APP_DEBUG=false
# URL publik aplikasi (dipakai pada tautan email), tanpa garis miring akhir.
APP_URL=https://pos.example.com
APP_TIMEZONE=Asia/Jakarta

# Batas pendaftaran per IP (hanya percobaan yang lolos validasi dihitung).
REGISTRATION_MAX_ATTEMPTS=20
REGISTRATION_WINDOW_SECONDS=3600

# Batas login gagal agregat per IP (semua email) dalam 15 menit; batas permintaan reset password per jam.
LOGIN_IP_MAX_ATTEMPTS=50
RESET_REQUEST_MAX_ATTEMPTS=5
RESET_REQUEST_WINDOW_SECONDS=3600

# Email dukungan pada halaman /bantuan (opsional).
SUPPORT_EMAIL=

# Cookie sesi Secure + HSTS: true | false | auto (auto = ikuti HTTPS request itu sendiri).
# Wajib true bila TLS diakhiri di proxy. Kosongkan agar bawaan: true di production, selain itu auto.
SESSION_SECURE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_retail
DB_USER=changeme
DB_PASSWORD=changeme

# smtp = kirim sungguhan (wajib di production). log = tulis ke storage/logs/mail.log (hanya pengembangan):
# berkas itu memuat tautan token reset/verifikasi/undangan apa adanya, siapa pun yang dapat membaca
# storage/ bisa mengambil alih akun. Di APP_ENV=production driver log ditolak kecuali MAIL_ALLOW_LOG=true.
MAIL_DRIVER=smtp
MAIL_ALLOW_LOG=false
# Berkas log untuk driver log (relatif terhadap direktori proyek).
MAIL_LOG_PATH=storage/logs/mail.log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
# none | starttls | tls
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="POS Retail"
MAIL_TIMEOUT=10
MAIL_EHLO_HOSTNAME=localhost

INSTALL_TOKEN=
